<View>
  <Header value="Box every product unit; give each box a group code (same code = same product, within this image)"/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>
  <RectangleLabels name="box" toName="image" strokeWidth="2">
    <Label value="product" background="#22c55e"/>
  </RectangleLabels>
  <TextArea name="group" toName="image" perRegion="true" required="true"
            maxSubmissions="1" editable="true" displayMode="region-list"
            placeholder="group code, e.g. a"/>
</View>
