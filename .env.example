# Copy to .env and adjust. Every variable the services read is listed here.

# --- Gateway -------------------------------------------------------------
DETECTOR_BASE_URL=http://127.0.0.1:8001
GROUPING_BASE_URL=http://127.0.0.1:8002
# Seconds to wait for detector/grouping before returning 504
REQUEST_TIMEOUT=30
# Shared by gateway and grouping (grouping writes, gateway serves)
OUTPUT_DIR=outputs

# --- Upload limits (gateway and detector) -------------------------------
# Max uploaded file size; larger uploads get 413
MAX_UPLOAD_MB=10
# Max width x height; larger images get 413
MAX_IMAGE_PIXELS=40000000

# --- Detector ------------------------------------------------------------
# Path to YOLO weights. Relative paths resolve from the directory you start in
# (repo root for run_all.py). Cross-platform resolution is fixed in M1.4 (#14).
MODEL_PATH=models/yolov8n.pt
SLICE_SIZE=512
OVERLAP=0.4
IOU_THRESHOLD=0.4
MIN_AREA_RATIO=0.0005
MAX_AREA_RATIO=0.03

# --- Grouping ------------------------------------------------------------
# Max size of the detector -> grouping JSON payload (image + crops, base64)
MAX_PAYLOAD_MB=50
MODEL_NAME=resnet18
IMAGE_SIZE=224
DEVICE=cpu
EMBED_BATCH_SIZE=32
DISTANCE_THRESHOLD=0.6
CLUSTERING_METRIC=euclidean
CLUSTERING_LINKAGE=average
SPATIAL_WEIGHT=0.1
